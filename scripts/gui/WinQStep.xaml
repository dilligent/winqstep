<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinQStep" Height="760" Width="1120" MinHeight="620" MinWidth="900"
        Background="#F5F7FA" FontFamily="Segoe UI, Microsoft YaHei UI, Microsoft YaHei" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style TargetType="TextBox">
      <Setter Property="Margin" Value="6,4"/>
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Margin" Value="6,4"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="MinWidth" Value="90"/>
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="TemplateSectionGroupBoxStyle" TargetType="GroupBox">
      <Setter Property="Margin" Value="0,6,0,2"/>
      <Setter Property="Padding" Value="10,8,10,10"/>
      <Setter Property="BorderBrush" Value="#C7D2DE"/>
      <Setter Property="Background" Value="#FAFBFC"/>
    </Style>
  </Window.Resources>
  <ScrollViewer x:Name="MainScrollViewer"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                CanContentScroll="False">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="WinQStep" FontSize="22" FontWeight="SemiBold" Margin="0,4,16,4"/>
      <WrapPanel x:Name="ActionButtonPanel" Grid.Column="1" HorizontalAlignment="Right">
        <Button x:Name="LoadConfigButton" Content="Load Config"/>
        <Button x:Name="SaveConfigButton" Content="Save Config"/>
        <Button x:Name="LoadTemplateButton" Content="Load Template"/>
        <Button x:Name="SaveTemplateButton" Content="Save Template"/>
        <Button x:Name="InspectDataButton" Content="Inspect Data"/>
        <Button x:Name="DetectButton" Content="Detect"/>
        <Button x:Name="ImportButton" Content="Import"/>
        <Button x:Name="PreviewButton" Content="Preview"/>
        <Button x:Name="RunButton" Content="Run"/>
        <Button x:Name="CancelJobButton" Content="Stop"/>
        <Button x:Name="HistoryButton" Content="History"/>
        <Button x:Name="ClearButton" Content="Clear"/>
      </WrapPanel>
    </Grid>

    <GroupBox x:Name="JobInputsGroup" Grid.Row="1" Header="Job Inputs" Padding="10" Margin="0,10,0,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="110"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="ModeLabel" Grid.Row="0" Grid.Column="0" Text="Mode"/>
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="6,4">
          <RadioButton x:Name="WorkflowModeRadio" Content="Workflow" GroupName="JobMode" IsChecked="True" Margin="0,0,18,0"/>
          <RadioButton x:Name="ExistingInputModeRadio" Content="Existing input" GroupName="JobMode"/>
        </StackPanel>

        <TextBlock x:Name="ConfigPathLabel" Grid.Row="1" Grid.Column="0" Text="Config"/>
        <TextBox x:Name="ConfigPathBox" Grid.Row="1" Grid.Column="1"/>
        <Button x:Name="BrowseConfigButton" Grid.Row="1" Grid.Column="2" Content="Browse"/>

        <TextBlock x:Name="TemplatePathLabel" Grid.Row="2" Grid.Column="0" Text="Template"/>
        <TextBox x:Name="TemplatePathBox" Grid.Row="2" Grid.Column="1"/>
        <Button x:Name="BrowseTemplateButton" Grid.Row="2" Grid.Column="2" Content="Browse"/>

        <TextBlock x:Name="StructurePathLabel" Grid.Row="3" Grid.Column="0" Text="Structure"/>
        <TextBox x:Name="StructurePathBox" Grid.Row="3" Grid.Column="1"/>
        <Button x:Name="BrowseStructureButton" Grid.Row="3" Grid.Column="2" Content="Browse"/>

        <TextBlock x:Name="ExistingInputPathLabel" Grid.Row="4" Grid.Column="0" Text="Existing Input"/>
        <TextBox x:Name="ExistingInputPathBox" Grid.Row="4" Grid.Column="1"/>
        <Button x:Name="BrowseExistingInputButton" Grid.Row="4" Grid.Column="2" Content="Browse"/>

        <TextBlock x:Name="JobFolderLabel" Grid.Row="5" Grid.Column="0" Text="Job Folder"/>
        <TextBox x:Name="JobDirBox" Grid.Row="5" Grid.Column="1"/>
        <Button x:Name="BrowseJobDirButton" Grid.Row="5" Grid.Column="2" Content="Browse"/>

        <TextBlock x:Name="ProjectLabel" Grid.Row="6" Grid.Column="0" Text="Project"/>
        <TextBox x:Name="ProjectNameBox" Grid.Row="6" Grid.Column="1"/>
      </Grid>
    </GroupBox>

    <TabControl x:Name="MainTabs" Grid.Row="2">
      <TabItem x:Name="ConfigTab" Header="Config">
        <Grid Margin="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <TextBlock x:Name="DistroLabel" Grid.Row="0" Grid.Column="0" Text="Distro"/>
          <TextBox x:Name="DistroBox" Grid.Row="0" Grid.Column="1"/>

          <TextBlock x:Name="Cp2kCommandLabel" Grid.Row="1" Grid.Column="0" Text="CP2K Executable"/>
          <TextBox x:Name="Cp2kCommandBox" Grid.Row="1" Grid.Column="1"/>

          <TextBlock x:Name="Cp2kDataDirLabel" Grid.Row="2" Grid.Column="0" Text="CP2K Data Dir"/>
          <TextBox x:Name="Cp2kDataDirBox" Grid.Row="2" Grid.Column="1"/>

          <TextBlock x:Name="MpiCommandLabel" Grid.Row="3" Grid.Column="0" Text="MPI Launcher"/>
          <TextBox x:Name="MpirunCommandBox" Grid.Row="3" Grid.Column="1"/>

          <TextBlock x:Name="WorkspaceLabel" Grid.Row="4" Grid.Column="0" Text="Workspace"/>
          <TextBox x:Name="DefaultWorkspaceBox" Grid.Row="4" Grid.Column="1"/>

          <TextBlock x:Name="WslPreludeLabel" Grid.Row="5" Grid.Column="0" Text="WSL Prelude"/>
          <TextBox x:Name="WslPreludeBox" Grid.Row="5" Grid.Column="1" Height="64"
                   AcceptsReturn="True" TextWrapping="NoWrap" VerticalContentAlignment="Top"
                   HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>

          <TextBlock x:Name="TimeoutLabel" Grid.Row="6" Grid.Column="0" Text="Timeout"/>
          <TextBox x:Name="TimeoutBox" Grid.Row="6" Grid.Column="1"/>

          <TextBlock x:Name="UiLanguageLabel" Grid.Row="7" Grid.Column="0" Text="UI Language"/>
          <ComboBox x:Name="UiLanguageBox" Grid.Row="7" Grid.Column="1" IsEditable="False" SelectedIndex="0">
            <ComboBoxItem Tag="" Content="System default"/>
            <ComboBoxItem Tag="en-US" Content="English (en-US)"/>
            <ComboBoxItem Tag="zh-CN" Content="中文 (zh-CN)"/>
          </ComboBox>
          <Button x:Name="ApplyLanguageButton" Grid.Row="7" Grid.Column="2" Content="Apply" MinWidth="72"/>

          <TextBox x:Name="ConfigValidationText" Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3"
                   FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI, Microsoft YaHei, SimSun"
                   FontSize="12" AcceptsReturn="True" TextWrapping="Wrap"
                   HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                   IsReadOnly="True"/>
        </Grid>
      </TabItem>
      <TabItem x:Name="EnvironmentTab" Header="Environment">
        <TextBox x:Name="EnvironmentText" FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI, Microsoft YaHei, SimSun" FontSize="12"
                 AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
      </TabItem>
      <TabItem x:Name="StructureTab" Header="Structure">
        <Grid Margin="8">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="260"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,4">
            <Button x:Name="StructureResetViewButton" DockPanel.Dock="Right" Content="Reset View" MinWidth="92"/>
            <TextBlock x:Name="StructurePreviewStatusText" Text="No structure preview loaded."/>
          </DockPanel>
          <Border Grid.Row="1" BorderBrush="#C7D2DE" BorderThickness="1" Background="#111827">
            <Viewport3D x:Name="StructurePreviewViewport" ClipToBounds="True">
              <Viewport3D.Camera>
                <PerspectiveCamera x:Name="StructurePreviewCamera"
                                   Position="0,0,10"
                                   LookDirection="0,0,-10"
                                   UpDirection="0,1,0"
                                   FieldOfView="45"/>
              </Viewport3D.Camera>
              <ModelVisual3D>
                <ModelVisual3D.Content>
                  <Model3DGroup>
                    <AmbientLight Color="#FF505A66"/>
                    <DirectionalLight Color="#FFFFFFFF" Direction="-0.7,-1.0,-1.4"/>
                    <DirectionalLight Color="#FFB8C7D9" Direction="0.8,0.5,1.2"/>
                  </Model3DGroup>
                </ModelVisual3D.Content>
              </ModelVisual3D>
              <ModelVisual3D x:Name="StructurePreviewVisual"/>
            </Viewport3D>
          </Border>
          <TextBox x:Name="StructureText" Grid.Row="2" FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI, Microsoft YaHei, SimSun" FontSize="12"
                   AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                   HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
        </Grid>
      </TabItem>
      <TabItem x:Name="TemplateTab" Header="Template">
        <StackPanel Margin="8">
          <GroupBox x:Name="TemplateGlobalGroup" Header="&amp;GLOBAL" Style="{StaticResource TemplateSectionGroupBoxStyle}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <TextBlock x:Name="TemplateProjectLabel" Grid.Row="0" Grid.Column="0" Text="Project"/>
              <ComboBox x:Name="TemplateProjectBox" Grid.Row="0" Grid.Column="1" IsEditable="True">
                <ComboBoxItem Content="workflow_energy"/>
                <ComboBoxItem Content="workflow_geo_opt"/>
                <ComboBoxItem Content="workflow_cell_opt"/>
                <ComboBoxItem Content="quickstep_energy"/>
                <ComboBoxItem Content="quickstep_geo_opt"/>
                <ComboBoxItem Content="quickstep_cell_opt"/>
              </ComboBox>
              <TextBlock x:Name="RunTypeLabel" Grid.Row="0" Grid.Column="2" Text="Run Type"/>
              <ComboBox x:Name="TemplateRunTypeBox" Grid.Row="0" Grid.Column="3" IsEditable="True">
                <ComboBoxItem Content="ENERGY"/>
                <ComboBoxItem Content="ENERGY_FORCE"/>
                <ComboBoxItem Content="GEO_OPT"/>
                <ComboBoxItem Content="CELL_OPT"/>
              </ComboBox>

              <TextBlock x:Name="PrintLevelLabel" Grid.Row="1" Grid.Column="0" Text="Print Level"/>
              <ComboBox x:Name="PrintLevelBox" Grid.Row="1" Grid.Column="1" IsEditable="True">
                <ComboBoxItem Content=""/>
                <ComboBoxItem Content="SILENT"/>
                <ComboBoxItem Content="LOW"/>
                <ComboBoxItem Content="MEDIUM"/>
                <ComboBoxItem Content="HIGH"/>
                <ComboBoxItem Content="DEBUG"/>
              </ComboBox>
            </Grid>
          </GroupBox>

          <GroupBox x:Name="TemplateDftGroup" Header="&amp;FORCE_EVAL / &amp;DFT" Style="{StaticResource TemplateSectionGroupBoxStyle}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <TextBlock x:Name="BasisFileLabel" Grid.Row="0" Grid.Column="0" Text="Basis File"/>
              <ComboBox x:Name="BasisSetFileBox" Grid.Row="0" Grid.Column="1" IsEditable="True">
                <ComboBoxItem Content="BASIS_MOLOPT"/>
                <ComboBoxItem Content="BASIS_SET"/>
                <ComboBoxItem Content="BASIS_MOLOPT_UCL"/>
                <ComboBoxItem Content="GTH_BASIS_SETS"/>
              </ComboBox>
              <TextBlock x:Name="PotentialFileLabel" Grid.Row="0" Grid.Column="2" Text="Potential File"/>
              <ComboBox x:Name="PotentialFileBox" Grid.Row="0" Grid.Column="3" IsEditable="True">
                <ComboBoxItem Content="GTH_POTENTIALS"/>
                <ComboBoxItem Content="POTENTIAL"/>
                <ComboBoxItem Content="POTENTIAL_UCL"/>
              </ComboBox>

              <TextBlock x:Name="XcFunctionalLabel" Grid.Row="1" Grid.Column="0" Text="XC Functional"/>
              <ComboBox x:Name="XcFunctionalBox" Grid.Row="1" Grid.Column="1" IsEditable="True">
                <ComboBoxItem Content="PBE"/>
                <ComboBoxItem Content="BLYP"/>
                <ComboBoxItem Content="BP"/>
                <ComboBoxItem Content="PADE"/>
                <ComboBoxItem Content="PBE0"/>
                <ComboBoxItem Content="B3LYP"/>
                <ComboBoxItem Content="TPSS"/>
                <ComboBoxItem Content="NO_SHORTCUT"/>
              </ComboBox>
              <TextBlock x:Name="ChargeLabel" Grid.Row="1" Grid.Column="2" Text="Charge"/>
              <ComboBox x:Name="ChargeBox" Grid.Row="1" Grid.Column="3" IsEditable="True">
                <ComboBoxItem Content="-2"/>
                <ComboBoxItem Content="-1"/>
                <ComboBoxItem Content="0"/>
                <ComboBoxItem Content="1"/>
                <ComboBoxItem Content="2"/>
              </ComboBox>

              <TextBlock x:Name="MultiplicityLabel" Grid.Row="2" Grid.Column="0" Text="Multiplicity"/>
              <ComboBox x:Name="MultiplicityBox" Grid.Row="2" Grid.Column="1" IsEditable="True">
                <ComboBoxItem Content="1"/>
                <ComboBoxItem Content="2"/>
                <ComboBoxItem Content="3"/>
                <ComboBoxItem Content="4"/>
              </ComboBox>
              <TextBlock x:Name="CutoffLabel" Grid.Row="2" Grid.Column="2" Text="Cutoff"/>
              <ComboBox x:Name="CutoffBox" Grid.Row="2" Grid.Column="3" IsEditable="True">
                <ComboBoxItem Content="300"/>
                <ComboBoxItem Content="400"/>
                <ComboBoxItem Content="500"/>
                <ComboBoxItem Content="600"/>
                <ComboBoxItem Content="800"/>
              </ComboBox>

              <TextBlock x:Name="RelCutoffLabel" Grid.Row="3" Grid.Column="0" Text="Rel Cutoff"/>
              <ComboBox x:Name="RelCutoffBox" Grid.Row="3" Grid.Column="1" IsEditable="True">
                <ComboBoxItem Content="30"/>
                <ComboBoxItem Content="40"/>
                <ComboBoxItem Content="50"/>
                <ComboBoxItem Content="60"/>
              </ComboBox>
            </Grid>
          </GroupBox>

          <GroupBox x:Name="TemplateScfGroup" Header="&amp;FORCE_EVAL / &amp;DFT / &amp;SCF" Style="{StaticResource TemplateSectionGroupBoxStyle}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <TextBlock x:Name="EpsScfLabel" Grid.Row="0" Grid.Column="0" Text="EPS SCF"/>
              <ComboBox x:Name="EpsScfBox" Grid.Row="0" Grid.Column="1" IsEditable="True">
                <ComboBoxItem Content="1.0E-5"/>
                <ComboBoxItem Content="1.0E-6"/>
                <ComboBoxItem Content="1.0E-7"/>
                <ComboBoxItem Content="1.0E-8"/>
              </ComboBox>
              <TextBlock x:Name="MaxScfLabel" Grid.Row="0" Grid.Column="2" Text="Max SCF"/>
              <ComboBox x:Name="MaxScfBox" Grid.Row="0" Grid.Column="3" IsEditable="True">
                <ComboBoxItem Content="30"/>
                <ComboBoxItem Content="50"/>
                <ComboBoxItem Content="100"/>
                <ComboBoxItem Content="200"/>
              </ComboBox>

              <TextBlock x:Name="ScfMethodLabel" Grid.Row="1" Grid.Column="0" Text="SCF Method"/>
              <ComboBox x:Name="ScfMethodBox" Grid.Row="1" Grid.Column="1" IsEditable="True">
                <ComboBoxItem Content="DEFAULT"/>
                <ComboBoxItem Content="DIAGONALIZATION"/>
                <ComboBoxItem Content="OT"/>
              </ComboBox>
              <TextBlock x:Name="AddedMosLabel" Grid.Row="1" Grid.Column="2" Text="Added MOs"/>
              <ComboBox x:Name="AddedMosBox" Grid.Row="1" Grid.Column="3" IsEditable="True">
                <ComboBoxItem Content="0"/>
                <ComboBoxItem Content="4"/>
                <ComboBoxItem Content="8"/>
                <ComboBoxItem Content="16"/>
                <ComboBoxItem Content="-1"/>
              </ComboBox>

              <TextBlock x:Name="DiagonalizationAlgorithmLabel" Grid.Row="2" Grid.Column="0" Text="Diag Algorithm"/>
              <ComboBox x:Name="DiagonalizationAlgorithmBox" Grid.Row="2" Grid.Column="1" IsEditable="True">
                <ComboBoxItem Content="STANDARD"/>
                <ComboBoxItem Content="DAVIDSON"/>
                <ComboBoxItem Content="LANCZOS"/>
                <ComboBoxItem Content="FILTER_MATRIX"/>
              </ComboBox>
              <TextBlock x:Name="OtMinimizerLabel" Grid.Row="2" Grid.Column="2" Text="OT Minimizer"/>
              <ComboBox x:Name="OtMinimizerBox" Grid.Row="2" Grid.Column="3" IsEditable="True">
                <ComboBoxItem Content="CG"/>
                <ComboBoxItem Content="DIIS"/>
                <ComboBoxItem Content="SD"/>
                <ComboBoxItem Content="BROYDEN"/>
              </ComboBox>

              <TextBlock x:Name="OtPreconditionerLabel" Grid.Row="3" Grid.Column="0" Text="OT Preconditioner"/>
              <ComboBox x:Name="OtPreconditionerBox" Grid.Row="3" Grid.Column="1" IsEditable="True">
                <ComboBoxItem Content="FULL_KINETIC"/>
                <ComboBoxItem Content="FULL_ALL"/>
                <ComboBoxItem Content="FULL_SINGLE"/>
                <ComboBoxItem Content="FULL_SINGLE_INVERSE"/>
                <ComboBoxItem Content="FULL_S_INVERSE"/>
                <ComboBoxItem Content="NONE"/>
              </ComboBox>
            </Grid>
          </GroupBox>

          <GroupBox x:Name="TemplateOuterScfGroup" Header="&amp;FORCE_EVAL / &amp;DFT / &amp;SCF / &amp;OUTER_SCF" Style="{StaticResource TemplateSectionGroupBoxStyle}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <CheckBox x:Name="OuterScfEnabledBox" Grid.Row="0" Grid.Column="0" Content="Outer SCF" Margin="6,4" VerticalAlignment="Center"/>
              <TextBlock x:Name="OuterScfEpsScfLabel" Grid.Row="0" Grid.Column="2" Text="Outer EPS SCF"/>
              <ComboBox x:Name="OuterScfEpsScfBox" Grid.Row="0" Grid.Column="3" IsEditable="True">
                <ComboBoxItem Content="1.0E-5"/>
                <ComboBoxItem Content="1.0E-6"/>
                <ComboBoxItem Content="1.0E-7"/>
                <ComboBoxItem Content="1.0E-8"/>
              </ComboBox>
              <TextBlock x:Name="OuterScfMaxScfLabel" Grid.Row="1" Grid.Column="0" Text="Outer Max SCF"/>
              <ComboBox x:Name="OuterScfMaxScfBox" Grid.Row="1" Grid.Column="1" IsEditable="True">
                <ComboBoxItem Content="10"/>
                <ComboBoxItem Content="20"/>
                <ComboBoxItem Content="50"/>
                <ComboBoxItem Content="100"/>
              </ComboBox>
            </Grid>
          </GroupBox>

          <GroupBox x:Name="TemplateMixingGroup" Header="&amp;FORCE_EVAL / &amp;DFT / &amp;SCF / &amp;MIXING" Style="{StaticResource TemplateSectionGroupBoxStyle}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <CheckBox x:Name="MixingEnabledBox" Grid.Row="0" Grid.Column="0" Content="Mixing" Margin="6,4" VerticalAlignment="Center"/>
              <TextBlock x:Name="MixingMethodLabel" Grid.Row="0" Grid.Column="2" Text="Mixing Method"/>
              <ComboBox x:Name="MixingMethodBox" Grid.Row="0" Grid.Column="3" IsEditable="True">
                <ComboBoxItem Content="BROYDEN_MIXING"/>
                <ComboBoxItem Content="DIRECT_P_MIXING"/>
                <ComboBoxItem Content="PULAY_MIXING"/>
                <ComboBoxItem Content="KERKER_MIXING"/>
                <ComboBoxItem Content="MULTISECANT_MIXING"/>
                <ComboBoxItem Content="NEW_PULAY_MIXING"/>
              </ComboBox>

              <TextBlock x:Name="MixingAlphaLabel" Grid.Row="1" Grid.Column="0" Text="Mixing Alpha"/>
              <ComboBox x:Name="MixingAlphaBox" Grid.Row="1" Grid.Column="1" IsEditable="True">
                <ComboBoxItem Content="0.2"/>
                <ComboBoxItem Content="0.3"/>
                <ComboBoxItem Content="0.4"/>
                <ComboBoxItem Content="0.5"/>
              </ComboBox>
              <TextBlock x:Name="MixingBetaLabel" Grid.Row="1" Grid.Column="2" Text="Mixing Beta"/>
              <ComboBox x:Name="MixingBetaBox" Grid.Row="1" Grid.Column="3" IsEditable="True">
                <ComboBoxItem Content="0.5"/>
                <ComboBoxItem Content="1.0"/>
                <ComboBoxItem Content="1.5"/>
                <ComboBoxItem Content="2.0"/>
              </ComboBox>
            </Grid>
          </GroupBox>

          <GroupBox x:Name="TemplateSmearingGroup" Header="&amp;FORCE_EVAL / &amp;DFT / &amp;SCF / &amp;SMEAR" Style="{StaticResource TemplateSectionGroupBoxStyle}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <CheckBox x:Name="SmearingEnabledBox" Grid.Row="0" Grid.Column="0" Content="Smearing" Margin="6,4" VerticalAlignment="Center"/>
              <TextBlock x:Name="SmearingMethodLabel" Grid.Row="0" Grid.Column="2" Text="Smearing Method"/>
              <ComboBox x:Name="SmearingMethodBox" Grid.Row="0" Grid.Column="3" IsEditable="True">
                <ComboBoxItem Content="FERMI_DIRAC"/>
                <ComboBoxItem Content="ENERGY_WINDOW"/>
                <ComboBoxItem Content="GAUSSIAN"/>
                <ComboBoxItem Content="METHFESSEL_PAXTON"/>
                <ComboBoxItem Content="MARZARI_VANDERBILT"/>
              </ComboBox>

              <TextBlock x:Name="ElectronicTemperatureLabel" Grid.Row="1" Grid.Column="0" Text="Electronic Temp"/>
              <ComboBox x:Name="ElectronicTemperatureBox" Grid.Row="1" Grid.Column="1" IsEditable="True">
                <ComboBoxItem Content="300"/>
                <ComboBoxItem Content="500"/>
                <ComboBoxItem Content="1000"/>
                <ComboBoxItem Content="1500"/>
              </ComboBox>
            </Grid>
          </GroupBox>

          <GroupBox x:Name="TemplateGeoOptGroup" Header="&amp;MOTION / &amp;GEO_OPT" Style="{StaticResource TemplateSectionGroupBoxStyle}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <TextBlock x:Name="OptimizerLabel" Grid.Row="0" Grid.Column="0" Text="Optimizer"/>
              <ComboBox x:Name="GeoOptimizerBox" Grid.Row="0" Grid.Column="1" IsEditable="True">
                <ComboBoxItem Content="BFGS"/>
                <ComboBoxItem Content="LBFGS"/>
                <ComboBoxItem Content="CG"/>
              </ComboBox>
              <TextBlock x:Name="GeoMaxIterLabel" Grid.Row="0" Grid.Column="2" Text="GEO Max Iter"/>
              <ComboBox x:Name="GeoMaxIterBox" Grid.Row="0" Grid.Column="3" IsEditable="True">
                <ComboBoxItem Content="50"/>
                <ComboBoxItem Content="100"/>
                <ComboBoxItem Content="150"/>
                <ComboBoxItem Content="200"/>
              </ComboBox>
            </Grid>
          </GroupBox>

          <GroupBox x:Name="TemplateCellOptGroup" Header="&amp;MOTION / &amp;CELL_OPT" Style="{StaticResource TemplateSectionGroupBoxStyle}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <TextBlock x:Name="CellOptTypeLabel" Grid.Row="0" Grid.Column="0" Text="CELL_OPT Type"/>
              <ComboBox x:Name="CellOptTypeBox" Grid.Row="0" Grid.Column="1" IsEditable="True">
                <ComboBoxItem Content="DIRECT_CELL_OPT"/>
              </ComboBox>
              <TextBlock x:Name="CellOptMaxIterLabel" Grid.Row="0" Grid.Column="2" Text="CELL Max Iter"/>
              <ComboBox x:Name="CellOptMaxIterBox" Grid.Row="0" Grid.Column="3" IsEditable="True">
                <ComboBoxItem Content="20"/>
                <ComboBoxItem Content="50"/>
                <ComboBoxItem Content="100"/>
                <ComboBoxItem Content="200"/>
              </ComboBox>

              <TextBlock x:Name="CellOptOptimizerLabel" Grid.Row="1" Grid.Column="0" Text="CELL Optimizer"/>
              <ComboBox x:Name="CellOptOptimizerBox" Grid.Row="1" Grid.Column="1" IsEditable="True">
                <ComboBoxItem Content="BFGS"/>
                <ComboBoxItem Content="LBFGS"/>
                <ComboBoxItem Content="CG"/>
              </ComboBox>
              <TextBlock x:Name="CellOptPressureToleranceLabel" Grid.Row="1" Grid.Column="2" Text="Pressure Tol"/>
              <ComboBox x:Name="CellOptPressureToleranceBox" Grid.Row="1" Grid.Column="3" IsEditable="True">
                <ComboBoxItem Content="50"/>
                <ComboBoxItem Content="100"/>
                <ComboBoxItem Content="200"/>
                <ComboBoxItem Content="500"/>
              </ComboBox>

              <CheckBox x:Name="CellOptKeepAnglesBox" Grid.Row="2" Grid.Column="0"
                        Content="Keep Angles" Margin="6,4" VerticalAlignment="Center"/>
              <CheckBox x:Name="CellOptKeepSymmetryBox" Grid.Row="2" Grid.Column="1"
                        Content="Keep Symmetry" Margin="6,4" VerticalAlignment="Center"/>
            </Grid>
          </GroupBox>

          <GroupBox x:Name="TemplateCellGroup" Header="&amp;FORCE_EVAL / &amp;SUBSYS / &amp;CELL" Style="{StaticResource TemplateSectionGroupBoxStyle}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <TextBlock x:Name="FallbackPeriodicLabel" Grid.Row="0" Grid.Column="0" Text="Fallback Periodic"/>
              <ComboBox x:Name="FallbackPeriodicBox" Grid.Row="0" Grid.Column="1" IsEditable="True">
                <ComboBoxItem Content="XYZ"/>
                <ComboBoxItem Content="NONE"/>
                <ComboBoxItem Content="X"/>
                <ComboBoxItem Content="Y"/>
                <ComboBoxItem Content="Z"/>
                <ComboBoxItem Content="XY"/>
                <ComboBoxItem Content="XZ"/>
                <ComboBoxItem Content="YZ"/>
              </ComboBox>
              <TextBlock x:Name="FallbackCellALabel" Grid.Row="0" Grid.Column="2" Text="Fallback Cell A"/>
              <ComboBox x:Name="FallbackCellABox" Grid.Row="0" Grid.Column="3" IsEditable="True">
                <ComboBoxItem Content="10 0 0"/>
                <ComboBoxItem Content="12 0 0"/>
                <ComboBoxItem Content="15 0 0"/>
                <ComboBoxItem Content="20 0 0"/>
                <ComboBoxItem Content="5.43 0 0"/>
              </ComboBox>

              <TextBlock x:Name="FallbackCellBLabel" Grid.Row="1" Grid.Column="0" Text="Fallback Cell B"/>
              <ComboBox x:Name="FallbackCellBBox" Grid.Row="1" Grid.Column="1" IsEditable="True">
                <ComboBoxItem Content="0 10 0"/>
                <ComboBoxItem Content="0 12 0"/>
                <ComboBoxItem Content="0 15 0"/>
                <ComboBoxItem Content="0 20 0"/>
                <ComboBoxItem Content="0 5.43 0"/>
              </ComboBox>
              <TextBlock x:Name="FallbackCellCLabel" Grid.Row="1" Grid.Column="2" Text="Fallback Cell C"/>
              <ComboBox x:Name="FallbackCellCBox" Grid.Row="1" Grid.Column="3" IsEditable="True">
                <ComboBoxItem Content="0 0 10"/>
                <ComboBoxItem Content="0 0 12"/>
                <ComboBoxItem Content="0 0 15"/>
                <ComboBoxItem Content="0 0 20"/>
                <ComboBoxItem Content="0 0 5.43"/>
              </ComboBox>
            </Grid>
          </GroupBox>

          <GroupBox x:Name="TemplateKpointsGroup" Header="&amp;FORCE_EVAL / &amp;DFT / &amp;KPOINTS" Style="{StaticResource TemplateSectionGroupBoxStyle}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <TextBlock x:Name="KpointsSchemeLabel" Grid.Row="0" Grid.Column="0" Text="KPOINTS Scheme"/>
              <ComboBox x:Name="KpointsSchemeBox" Grid.Row="0" Grid.Column="1" IsEditable="True">
                <ComboBoxItem Content="NONE"/>
                <ComboBoxItem Content="GAMMA"/>
                <ComboBoxItem Content="MONKHORST-PACK"/>
              </ComboBox>
              <TextBlock x:Name="KpointsGridLabel" Grid.Row="0" Grid.Column="2" Text="KPOINTS Grid"/>
              <ComboBox x:Name="KpointsGridBox" Grid.Row="0" Grid.Column="3" IsEditable="True">
                <ComboBoxItem Content="1 1 1"/>
                <ComboBoxItem Content="2 2 2"/>
                <ComboBoxItem Content="3 3 3"/>
                <ComboBoxItem Content="4 4 4"/>
                <ComboBoxItem Content="6 6 6"/>
              </ComboBox>

              <CheckBox x:Name="KpointsFullGridBox" Grid.Row="1" Grid.Column="0"
                        Content="Full K Grid" Margin="6,4" VerticalAlignment="Center"/>
              <CheckBox x:Name="KpointsSymmetryBox" Grid.Row="1" Grid.Column="1"
                        Content="KPOINTS Symmetry" Margin="6,4" VerticalAlignment="Center"/>
              <TextBlock x:Name="KpointsWavefunctionsLabel" Grid.Row="1" Grid.Column="2" Text="Wavefunctions"/>
              <ComboBox x:Name="KpointsWavefunctionsBox" Grid.Row="1" Grid.Column="3" IsEditable="True">
                <ComboBoxItem Content="COMPLEX"/>
                <ComboBoxItem Content="REAL"/>
              </ComboBox>
            </Grid>
          </GroupBox>

          <CheckBox x:Name="CenterAtomsBox" Content="Center Atoms" Margin="6,8,6,6" VerticalAlignment="Center"/>

          <GroupBox x:Name="TemplateKindGroup" Header="&amp;FORCE_EVAL / &amp;SUBSYS / &amp;KIND" Style="{StaticResource TemplateSectionGroupBoxStyle}">
            <StackPanel>
              <DataGrid x:Name="KindEntriesGrid" Height="170"
                        AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True"
                        SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" FontSize="12">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Element" Binding="{Binding element, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                  <DataGridTextColumn Header="Basis Set" Binding="{Binding basis_set, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                  <DataGridTextColumn Header="Potential" Binding="{Binding potential, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                </DataGrid.Columns>
              </DataGrid>
              <TextBox x:Name="KindsText" Height="170" Visibility="Collapsed"
                       FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI, Microsoft YaHei, SimSun"
                       FontSize="12" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                       HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>

              <DataGrid x:Name="DataLabelsGrid" Height="130" Visibility="Collapsed"
                        AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                        HeadersVisibility="Column" GridLinesVisibility="Horizontal" FontSize="12">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Element" Binding="{Binding element}" Width="70"/>
                  <DataGridTextColumn Header="Basis Sets" Binding="{Binding basis_sets}" Width="*"/>
                  <DataGridTextColumn Header="Potentials" Binding="{Binding potentials}" Width="*"/>
                </DataGrid.Columns>
              </DataGrid>
            </StackPanel>
          </GroupBox>

          <TextBox x:Name="TemplateValidationText" Height="90" Margin="6,6,6,0"
                   FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI, Microsoft YaHei, SimSun"
                   FontSize="12" AcceptsReturn="True" TextWrapping="Wrap"
                   HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                   IsReadOnly="True"/>
        </StackPanel>
      </TabItem>
      <TabItem x:Name="InputPreviewTab" Header="Input Preview">
        <TextBox x:Name="PreviewText" FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI, Microsoft YaHei, SimSun" FontSize="12"
                 AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
      </TabItem>
      <TabItem x:Name="JobLogTab" Header="Job Log">
        <TextBox x:Name="LogText" FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI, Microsoft YaHei, SimSun" FontSize="12"
                 AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
      </TabItem>
      <TabItem x:Name="ArtifactsTab" Header="Artifacts">
        <Grid Margin="8">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="120"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <WrapPanel Grid.Row="0" Margin="0,0,0,6">
            <Button x:Name="ViewResultsButton" Content="Results"/>
            <Button x:Name="SaveResultsButton" Content="Save Results"/>
            <Button x:Name="ViewInputButton" Content="Input"/>
            <Button x:Name="ViewOutputButton" Content="Output"/>
            <Button x:Name="ViewMetadataButton" Content="Metadata"/>
            <Button x:Name="ViewStdoutButton" Content="Stdout"/>
            <Button x:Name="ViewStderrButton" Content="Stderr"/>
          </WrapPanel>
          <TextBox x:Name="ArtifactSummaryText" Grid.Row="1"
                   FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI, Microsoft YaHei, SimSun"
                   FontSize="12" AcceptsReturn="True" TextWrapping="Wrap"
                   HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                   IsReadOnly="True"/>
          <TextBox x:Name="ArtifactText" Grid.Row="2"
                   FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI, Microsoft YaHei, SimSun"
                   FontSize="12" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                   HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                   IsReadOnly="True"/>
        </Grid>
      </TabItem>
      <TabItem x:Name="HistoryTab" Header="History">
        <DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  FontSize="12">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Completed" Binding="{Binding completed_at}" Width="155"/>
            <DataGridTextColumn Header="Mode" Binding="{Binding mode}" Width="115"/>
            <DataGridTextColumn Header="Status" Binding="{Binding status}" Width="90"/>
            <DataGridTextColumn Header="Code" Binding="{Binding returncode}" Width="55"/>
            <DataGridTextColumn Header="Warnings" Binding="{Binding warning_count}" Width="75"/>
            <DataGridTextColumn Header="Project/Input" Binding="{Binding project_name}" Width="160"/>
            <DataGridTextColumn Header="Output" Binding="{Binding output_path}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
    </TabControl>

    <StatusBar Grid.Row="3" Margin="0,10,0,0">
      <StatusBarItem>
        <TextBlock x:Name="StatusText" Text="Ready"/>
      </StatusBarItem>
      <Separator/>
      <StatusBarItem HorizontalAlignment="Stretch">
        <TextBlock x:Name="JobStatusText" Text="" TextTrimming="CharacterEllipsis"/>
      </StatusBarItem>
    </StatusBar>
  </Grid>
  </ScrollViewer>
</Window>
