# Generated by WinQStep. You can edit this CP2K input manually.
&GLOBAL
  PROJECT_NAME si_cell_opt
  RUN_TYPE CELL_OPT
&END GLOBAL

&FORCE_EVAL
  METHOD QS
  STRESS_TENSOR ANALYTICAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    CHARGE 0
    MULTIPLICITY 1
    &MGRID
      CUTOFF 400
      REL_CUTOFF 40
    &END MGRID
    &POISSON
      PERIODIC XYZ
    &END POISSON
    &KPOINTS
      SCHEME MONKHORST-PACK 2 2 2
    &END KPOINTS
    &SCF
      EPS_SCF 1.0E-5
      MAX_SCF 80
      ADDED_MOS 8
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.2
        BETA 1.5
      &END MIXING
      &SMEAR ON
        METHOD FERMI_DIRAC
        TELEC [K] 500
      &END SMEAR
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      PERIODIC XYZ
      A 5.43 0 0
      B 0 5.43 0
      C 0 0 5.43
    &END CELL
    &COORD
      Si 0 0 0
      Si 1.3575 1.3575 1.3575
    &END COORD
    &KIND Si
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q4
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

&MOTION
  &CELL_OPT
    OPTIMIZER BFGS
    MAX_ITER 20
    TYPE DIRECT_CELL_OPT
    PRESSURE_TOLERANCE [bar] 100
    KEEP_ANGLES T
  &END CELL_OPT
&END MOTION
